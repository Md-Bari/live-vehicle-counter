# Copy to .env to override docker compose defaults
APP_PORT=8088            # host port of the dashboard
DEFAULT_MODEL=yolo26m    # yolo26m (accurate) or yolo26s (fast)
MODELS_PATH=../models    # folder with vehicle_yolo26m.pt and vehicle_yolo26s.pt
COMPOSE_BAKE=false      # classic builder (bake asks for extra permissions on Windows)
